{
  "info": {
    "_postman_id": "6f0c1d2e-7a3b-4c5d-9e8f-techgear0001",
    "name": "TechGear API",
    "description": "Kiểm thử API backend TechGear. Chạy cả bộ: npx -y newman@6 run postman/TechGear.postman_collection.json -e postman/TechGear.local.postman_environment.json\nMỗi thư mục ứng với một module; token đăng nhập tự lưu vào biến môi trường.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mọi lỗi từ backend phải đúng định dạng { thoiGian, trangThai, thongBao }",
          "if (pm.response.code >= 400 && (pm.response.headers.get('Content-Type') || '').includes('application/json')) {",
          "    pm.test('Lỗi đúng định dạng { thoiGian, trangThai, thongBao }', function () {",
          "        const j = pm.response.json();",
          "        pm.expect(j.thoiGian).to.match(/\\+07:00$/);",
          "        pm.expect(j.trangThai).to.eql(pm.response.code);",
          "        pm.expect(j.thongBao).to.be.a('string').and.not.empty;",
          "    });",
          "}"
        ]
      }
    }
  ],
