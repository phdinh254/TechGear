# Biến môi trường của backend TechGear (sao chép thành .env hoặc đặt trong IDE/hệ điều hành – KHÔNG commit giá trị thật).
# Chạy dev (mvn spring-boot:run) không cần đặt gì: profile dev có sẵn giá trị mặc định.

# CSDL
DB_URL=jdbc:postgresql://localhost:5433/techgear
DB_USERNAME=techgear
DB_PASSWORD=

# Khóa ký JWT (HS256), tối thiểu 32 ký tự ngẫu nhiên – bắt buộc khi không chạy profile dev
JWT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email SMTP (bỏ trống MAIL_USERNAME thì không gửi được email đặt lại mật khẩu; chỉ profile dev in liên kết ra log)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=TechGear <no-reply@techgear.vn>

# Thư mục lưu ảnh upload
UPLOAD_DIR=uploads

# VNPay sandbox (đăng ký tại https://sandbox.vnpayment.vn). Profile dev có giá trị giả để test IPN bằng Postman.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua
