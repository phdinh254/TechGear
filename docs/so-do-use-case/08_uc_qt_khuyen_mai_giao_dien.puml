@startuml UC_QT_KhuyenMai
title Use case phân rã - Quản lý mã giảm giá, banner, cấu hình
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Quản trị viên" as QTV

rectangle "Trang quản trị TechGear" {
  usecase "Quản lý mã giảm giá" as U1
  usecase "Thêm mã giảm giá" as U2
  usecase "Sửa mã giảm giá" as U3
  usecase "Xóa mã giảm giá" as U4
  usecase "Bật/tắt mã giảm giá" as U5
  usecase "Quản lý banner" as U6
  usecase "Thêm banner" as U7
  usecase "Sửa banner" as U8
  usecase "Xóa banner" as U9
  usecase "Cấu hình cửa hàng" as U10
  usecase "Cập nhật thông tin liên hệ" as U11
  usecase "Cập nhật phí vận chuyển" as U12
}

QTV --> U1
U1 <.. U2 : <<extend>>
U1 <.. U3 : <<extend>>
U1 <.. U4 : <<extend>>
U1 <.. U5 : <<extend>>
QTV --> U6
U6 <.. U7 : <<extend>>
U6 <.. U8 : <<extend>>
U6 <.. U9 : <<extend>>
QTV --> U10
U10 <.. U11 : <<extend>>
U10 <.. U12 : <<extend>>


@enduml
