@startuml UC_QT_SanPham
title Use case phân rã - Quản lý danh mục, thương hiệu, sản phẩm
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Quản trị viên" as QTV

rectangle "Trang quản trị TechGear" {
  usecase "Quản lý danh mục" as U1
  usecase "Thêm danh mục" as U2
  usecase "Sửa danh mục" as U3
  usecase "Xóa danh mục" as U4
  usecase "Quản lý thương hiệu" as U5
  usecase "Thêm thương hiệu" as U6
  usecase "Sửa thương hiệu" as U7
  usecase "Xóa thương hiệu" as U8
  usecase "Quản lý sản phẩm" as U9
  usecase "Thêm sản phẩm" as U10
  usecase "Sửa sản phẩm" as U11
  usecase "Xóa sản phẩm" as U12
  usecase "Quản lý tùy chọn và biến thể\n(SKU, giá, tồn kho ban đầu)" as U13
  usecase "Quản lý hình ảnh sản phẩm" as U14
  usecase "Quản lý thông số kỹ thuật" as U15
}

QTV --> U1
U1 <.. U2 : <<extend>>
U1 <.. U3 : <<extend>>
U1 <.. U4 : <<extend>>
QTV --> U5
U5 <.. U6 : <<extend>>
U5 <.. U7 : <<extend>>
U5 <.. U8 : <<extend>>
QTV --> U9
U9 <.. U10 : <<extend>>
U9 <.. U11 : <<extend>>
U9 <.. U12 : <<extend>>
U9 <.. U13 : <<extend>>
U9 <.. U14 : <<extend>>
U9 <.. U15 : <<extend>>


@enduml
