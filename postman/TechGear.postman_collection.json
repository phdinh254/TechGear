                  "    pm.expect(n.email).to.eql(pm.collectionVariables.get('emailMoi'));",
                  "    pm.expect(n.vaiTro).to.eql('khach_hang');",
                  "});",
                  "pm.environment.set('token', pm.response.json().token);"
                ]
              }
            }
