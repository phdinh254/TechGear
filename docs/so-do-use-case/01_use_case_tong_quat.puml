@startuml UC_TongQuat
title Sơ đồ use case tổng quát - Website TechGear
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Khách vãng lai" as KVL
actor "Khách hàng" as KH
actor "Quản trị viên" as QTV
actor "Cổng thanh toán\nVNPay" as VNP <<Hệ thống>>
actor "Dịch vụ Email" as MAIL <<Hệ thống>>

KH -|> KVL

rectangle "Website TechGear" {
 rectangle "Chức năng phía khách hàng" as GKH {
  usecase "Xem và tìm kiếm\nsản phẩm" as UC1
  usecase "Quản lý giỏ hàng" as UC2
  usecase "Đặt hàng" as UC3
  usecase "Thanh toán\nqua VNPay" as UC4
  usecase "Đăng ký tài khoản" as UC5
  usecase "Đăng nhập" as UC6
  usecase "Quên mật khẩu" as UC7

  usecase "Quản lý thông tin\ncá nhân" as UC8
  usecase "Quản lý đơn hàng\ncủa tôi" as UC9
  usecase "Đánh giá sản phẩm" as UC10
  usecase "Quản lý sản phẩm\nyêu thích" as UC11
  usecase "Đăng xuất" as UC12

}
 rectangle "Chức năng quản trị" as GQT {
  usecase "Quản lý danh mục" as AD1
  usecase "Quản lý thương hiệu" as AD2
  usecase "Quản lý sản phẩm" as AD3
  usecase "Quản lý tồn kho" as AD4
  usecase "Quản lý đơn hàng" as AD5
  usecase "Quản lý mã giảm giá" as AD6
  usecase "Quản lý banner" as AD7
  usecase "Quản lý người dùng" as AD8
  usecase "Quản lý đánh giá" as AD9
  usecase "Cấu hình cửa hàng" as AD10
  usecase "Thống kê, báo cáo" as AD11
 }
}

KVL --> UC1
KVL --> UC2
KVL --> UC3
KVL --> UC5
KVL --> UC6
KVL --> UC7

KH --> UC8
KH --> UC9
KH --> UC10
KH --> UC11
KH --> UC12

UC4 .> UC3 : <<extend>>
UC4 --> VNP
UC7 --> MAIL

UC6 <-- QTV
UC12 <-- QTV
AD1 <-- QTV
AD2 <-- QTV
AD3 <-- QTV
AD4 <-- QTV
AD5 <-- QTV
AD6 <-- QTV
AD7 <-- QTV
AD8 <-- QTV
AD9 <-- QTV
AD10 <-- QTV
AD11 <-- QTV

UC1 -[hidden]-> AD1
UC2 -[hidden]-> AD3
UC8 -[hidden]-> AD5
UC9 -[hidden]-> AD8

note left of KH
  Khách hàng là khách vãng lai đã đăng nhập,
  kế thừa toàn bộ chức năng của khách vãng lai.
end note
@enduml
