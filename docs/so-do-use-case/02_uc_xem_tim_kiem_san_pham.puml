@startuml UC_XemTimKiem
title Use case phân rã - Xem và tìm kiếm sản phẩm
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Khách vãng lai" as KVL

rectangle "Website TechGear" {
  usecase "Xem trang chủ" as U1
  usecase "Xem sản phẩm nổi bật" as U2
  usecase "Xem danh mục sản phẩm" as U3
  usecase "Tìm kiếm sản phẩm" as U4
  usecase "Tìm theo từ khóa" as U5
  usecase "Lọc theo danh mục" as U6
  usecase "Lọc theo thương hiệu" as U7
  usecase "Lọc theo khoảng giá" as U8
  usecase "Sắp xếp kết quả" as U9
  usecase "Xem chi tiết sản phẩm" as U10
  usecase "Chọn biến thể\n(màu sắc, dung lượng, phiên bản)" as U11
  usecase "Xem thông số kỹ thuật" as U12
  usecase "Xem đánh giá sản phẩm" as U13
}

KVL --> U1
U1 <.. U2 : <<extend>>
U1 <.. U3 : <<extend>>
KVL --> U4
U4 <.. U5 : <<extend>>
U4 <.. U6 : <<extend>>
U4 <.. U7 : <<extend>>
U4 <.. U8 : <<extend>>
U4 <.. U9 : <<extend>>
KVL --> U10
U10 <.. U11 : <<extend>>
U10 <.. U12 : <<extend>>
U10 <.. U13 : <<extend>>

note left of KVL
  Khách hàng (đã đăng nhập) cũng
  thực hiện được các chức năng này.
end note
@enduml
