@startuml UC_TongQuat
title Sơ đồ use case tổng quát - Website TechGear
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Khách vãng lai" as KVL
actor "Khách hàng" as KH
actor "Quản trị viên" as QTV
actor "Cổng thanh toán\nVNPay" as VNP <<Hệ thống>>
actor "Dịch vụ Email" as MAIL <<Hệ thống>>

KH -|> KVL

rectangle "Website TechGear" {
  rectangle "Chức năng phía khách hàng" as GKH {
    usecase "UC01. Đăng ký tài khoản" as UC01
    usecase "UC03. Quên mật khẩu" as UC03
    usecase "UC05. Quản lý thông tin cá nhân" as UC05
    usecase "UC06. Quản lý sổ địa chỉ" as UC06
    usecase "UC07. Xem trang chủ" as UC07
    usecase "UC08. Tìm kiếm sản phẩm" as UC08
    usecase "UC09. Xem chi tiết sản phẩm" as UC09
    usecase "UC10. Quản lý giỏ hàng" as UC10
    usecase "UC11. Đặt hàng" as UC11
    usecase "UC12. Thanh toán qua VNPay" as UC12
    usecase "UC13. Quản lý đơn hàng của tôi" as UC13
    usecase "UC14. Đánh giá sản phẩm" as UC14
    usecase "UC15. Quản lý sản phẩm yêu thích" as UC15
    usecase "UC02. Đăng nhập" as UC02
    usecase "UC04. Đăng xuất" as UC04
  }

  rectangle "Chức năng quản trị" as GQT {
    usecase "UC16. Quản lý danh mục" as UC16
    usecase "UC17. Quản lý thương hiệu" as UC17
    usecase "UC18. Quản lý sản phẩm" as UC18
    usecase "UC19. Quản lý tồn kho" as UC19
    usecase "UC20. Quản lý đơn hàng" as UC20
    usecase "UC21. Quản lý mã giảm giá" as UC21
    usecase "UC22. Quản lý banner" as UC22
    usecase "UC23. Cấu hình cửa hàng" as UC23
    usecase "UC24. Quản lý người dùng" as UC24
    usecase "UC25. Quản lý đánh giá" as UC25
    usecase "UC26. Thống kê, báo cáo" as UC26
  }
}

' Khách vãng lai
KVL --> UC01
KVL --> UC02
KVL --> UC03
KVL --> UC07
KVL --> UC08
KVL --> UC09
KVL --> UC10
KVL --> UC11

' Khách hàng (kế thừa thêm chức năng của Khách vãng lai)
KH --> UC04
KH --> UC05
KH --> UC06
KH --> UC13
KH --> UC14
KH --> UC15

' Quản trị viên (đặt bên phải sơ đồ)
UC02 <-- QTV
UC04 <-- QTV
UC16 <-- QTV
UC17 <-- QTV
UC18 <-- QTV
UC19 <-- QTV
UC20 <-- QTV
UC21 <-- QTV
UC22 <-- QTV
UC23 <-- QTV
UC24 <-- QTV
UC25 <-- QTV
UC26 <-- QTV

' Quan hệ mở rộng và hệ thống ngoài
UC11 <. UC12 : <<extend>>
UC12 --> VNP
UC03 --> MAIL

' Căn bố cục (không hiển thị)
UC07 -[hidden]-> UC16
UC08 -[hidden]-> UC18
UC10 -[hidden]-> UC20
UC13 -[hidden]-> UC22
UC14 -[hidden]-> UC24
UC15 -[hidden]-> UC26
@enduml
