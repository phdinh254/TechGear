@startuml UC_GioHangDatHang
title Use case phân rã - Giỏ hàng, đặt hàng và thanh toán
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Khách vãng lai" as KVL
actor "Cổng thanh toán\nVNPay" as VNP <<Hệ thống>>

rectangle "Website TechGear" {
  usecase "Quản lý giỏ hàng" as U1
  usecase "Thêm sản phẩm vào giỏ" as U2
  usecase "Cập nhật số lượng" as U3
  usecase "Xóa sản phẩm khỏi giỏ" as U4
  usecase "Đặt hàng" as U5
  usecase "Nhập thông tin giao hàng" as U6
  usecase "Kiểm tra tồn kho" as U7
  usecase "Áp dụng mã giảm giá" as U8
  usecase "Thanh toán khi nhận hàng (COD)" as U9
  usecase "Thanh toán qua VNPay" as U10
}

KVL --> U1
U1 <.. U2 : <<extend>>
U1 <.. U3 : <<extend>>
U1 <.. U4 : <<extend>>
KVL --> U5
U5 ..> U6 : <<include>>
U5 ..> U7 : <<include>>
U5 <.. U8 : <<extend>>
U5 <.. U9 : <<extend>>
U5 <.. U10 : <<extend>>

U10 --> VNP
note left of KVL
  Khách hàng (đã đăng nhập) cũng
  thực hiện được các chức năng này;
  địa chỉ được chọn từ sổ địa chỉ.
end note
@enduml
