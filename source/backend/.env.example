# Biến môi trường của backend TechGear. Sao chép thành source/backend/.env (backend tự đọc khi chạy trong thư mục này)
# hoặc đặt trong IDE/hệ điều hành. File .env đã được .gitignore – KHÔNG commit, KHÔNG gửi khóa thật cho ai.
# Chỉ bỏ dấu # ở dòng cần đặt: dòng để trống (VD "JWT_SECRET=") sẽ ghi đè giá trị mặc định của profile dev bằng rỗng.
# Giá trị viết liền, không bọc trong dấu nháy. Chạy dev (mvn spring-boot:run) không cần đặt gì.

# CSDL
# DB_URL=jdbc:mysql://localhost:3307/techgear
# DB_USERNAME=techgear
# DB_PASSWORD=

# Khóa ký JWT (HS256), tối thiểu 32 ký tự ngẫu nhiên – bắt buộc khi không chạy profile dev
# JWT_SECRET=

# Frontend
# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email SMTP (bỏ trống MAIL_USERNAME thì không gửi được email đặt lại mật khẩu; chỉ profile dev in liên kết ra log)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=TechGear <no-reply@techgear.vn>

# Thư mục lưu ảnh upload
# UPLOAD_DIR=uploads

# PayOS (my.payos.vn > Kênh thanh toán > Thông tin tích hợp; PayOS không có sandbox – giao dịch là tiền thật).
# Profile dev giả lập khi chưa có khóa; đặt đủ 3 khóa dưới đây là tự dùng PayOS thật.
# Webhook cần đăng ký: https://<miền-backend>/api/thanh-toan/payos/webhook
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_API_URL=https://api-merchant.payos.vn
# PAYOS_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua
# PAYOS_CANCEL_URL=http://localhost:5173/thanh-toan/ket-qua
# PAYOS_GIA_LAP=false
