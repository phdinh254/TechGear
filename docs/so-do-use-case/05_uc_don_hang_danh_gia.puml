@startuml UC_DonHangKhachHang
title Use case phân rã - Đơn hàng, đánh giá, yêu thích (Khách hàng)
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 130
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F0FDFA
  BorderColor #0F766E
  ArrowColor #475569
}
skinparam actor {
  BorderColor #0F766E
  BackgroundColor #CCFBF1
}
skinparam rectangle {
  BorderColor #94A3B8
  FontStyle bold
}
skinparam ArrowFontSize 11
skinparam ArrowFontColor #475569
left to right direction

actor "Khách hàng" as KH

rectangle "Website TechGear" {
  usecase "Quản lý đơn hàng của tôi" as U1
  usecase "Xem lịch sử đơn hàng" as U2
  usecase "Xem chi tiết và\ntrạng thái đơn hàng" as U3
  usecase "Hủy đơn hàng" as U4
  usecase "Đánh giá sản phẩm" as U5
  usecase "Quản lý sản phẩm yêu thích" as U6
  usecase "Thêm vào yêu thích" as U7
  usecase "Bỏ yêu thích" as U8
  usecase "Xem danh sách yêu thích" as U9
}

KH --> U1
U1 <.. U2 : <<extend>>
U1 <.. U3 : <<extend>>
U1 <.. U4 : <<extend>>
KH --> U5
KH --> U6
U6 <.. U7 : <<extend>>
U6 <.. U8 : <<extend>>
U6 <.. U9 : <<extend>>

note right of U4
  Chỉ hủy được khi đơn ở
  trạng thái "Chờ xác nhận".
end note
note right of U5
  Chỉ đánh giá sản phẩm đã mua,
  thuộc đơn hàng đã hoàn thành.
end note
@enduml
