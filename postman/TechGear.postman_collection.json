                  "const gui = (n) => { if (n === 0) return; pm.sendRequest({",
                  "    url: pm.environment.get('baseUrl') + '/api/auth/dang-nhap', method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ email: e, matKhau: 'saimatkhau1' }) }",
                  "}, () => gui(n - 1)); };",
                  "gui(5);"
